#include <iostream>
#include <cmath>
using namespace std;

int main(){
    // define variables
    string operation;
    double num1, num2;

    //get use input 
    cout <<  " Enter First Number: ";
    cin >> num1;
    cout << " Enter Operation (+,-,*,/): ";
    cin >> operation;
    cout << " Enter Second Number: ";
    cin >> num2;

    //if else statement checking entered operation
    if (operation == "+"){
        cout <<  num1 + num2;
    } 
    else if (operation == "-"){
        cout << num1 - num2;
    } 
    else if (operation == "*"){
        cout << num1 * num2;
    } 
    else if (operation == "/"){
        cout << num1 / num2;
    } 
    else {
        cout << "Not a recognize operation!";
    }

}